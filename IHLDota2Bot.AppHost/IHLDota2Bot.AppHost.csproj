<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>04901ed6-d448-4909-923c-bf654280def0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.3" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.4.3" />
    <!-- NodeJs hosting isn't published on the 13.x line; 9.5.2 is its latest and
         AddNpmApp extends the same core Aspire.Hosting types, so it works with 13.x. -->
    <PackageReference Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
    <!-- Direct pin to lift a vulnerable transitive (via KubernetesClient): 2.5.192
         is flagged by GHSA-hv8m-jj95-wg3x; 2.5.302 is the patched 2.5.x line. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IHLDota2Bot.Desktop\IHLDota2Bot.Desktop.csproj" />
    <ProjectReference Include="..\IHLDota2Bot.Discord\IHLDota2Bot.Discord.csproj" />
    <ProjectReference Include="..\IHLDota2Bot\IHLDota2Bot.csproj" />
  </ItemGroup>
</Project>
