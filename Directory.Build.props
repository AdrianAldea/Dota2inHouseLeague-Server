<Project>
  <!--
    Solution-wide build settings. Phase 0 of the refactoring plan: now that the
    build is clean (0 warnings), promote warnings to errors so quality can't
    silently regress. Applies to every project in the solution unless a project
    overrides it.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
