<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:IHLDota2Bot.Desktop.ViewModels"
  xmlns:services="using:IHLDota2Bot.Desktop.Services"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1180"
  d:DesignHeight="760"
  x:Class="IHLDota2Bot.Desktop.Views.MainWindow"
  x:DataType="vm:MainWindowViewModel"
  Width="1180"
  Height="760"
  MinWidth="940"
  MinHeight="620"
  Background="{DynamicResource BgBaseBrush}"
  Icon="/Assets/app-icon.ico"
  Title="Dota IHL"
>
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!--
        Frameless layout: a 3x3 grid whose 8 outer cells are resize handles and whose
        centre cell holds the entire app UI. The handles form a thin draggable border
        and NEVER overlap the UI, so the title bar + buttons are always interactive.
    -->
  <Border
    BorderBrush="{DynamicResource BorderStrongBrush}"
    BorderThickness="1"
    Background="{DynamicResource BgSunkenBrush}"
  >
    <Grid RowDefinitions="5,*,5" ColumnDefinitions="5,*,5">
      <!-- Resize handles (transparent, edge/corner) -->
      <Border
        Grid.Row="0"
        Grid.Column="0"
        Background="Transparent"
        Cursor="TopLeftCorner"
        Tag="NorthWest"
        PointerPressed="ResizeEdge_PointerPressed"
      />
      <Border
        Grid.Row="0"
        Grid.Column="1"
        Background="Transparent"
        Cursor="SizeNorthSouth"
        Tag="North"
        PointerPressed="ResizeEdge_PointerPressed"
      />
      <Border
        Grid.Row="0"
        Grid.Column="2"
        Background="Transparent"
        Cursor="TopRightCorner"
        Tag="NorthEast"
        PointerPressed="ResizeEdge_PointerPressed"
      />
      <Border
        Grid.Row="1"
        Grid.Column="0"
        Background="Transparent"
        Cursor="SizeWestEast"
        Tag="West"
        PointerPressed="ResizeEdge_PointerPressed"
      />
      <Border
        Grid.Row="1"
        Grid.Column="2"
        Background="Transparent"
        Cursor="SizeWestEast"
        Tag="East"
        PointerPressed="ResizeEdge_PointerPressed"
      />
      <Border
        Grid.Row="2"
        Grid.Column="0"
        Background="Transparent"
        Cursor="BottomLeftCorner"
        Tag="SouthWest"
        PointerPressed="ResizeEdge_PointerPressed"
      />
      <Border
        Grid.Row="2"
        Grid.Column="1"
        Background="Transparent"
        Cursor="SizeNorthSouth"
        Tag="South"
        PointerPressed="ResizeEdge_PointerPressed"
      />
      <Border
        Grid.Row="2"
        Grid.Column="2"
        Background="Transparent"
        Cursor="BottomRightCorner"
        Tag="SouthEast"
        PointerPressed="ResizeEdge_PointerPressed"
      />

      <!-- ── App UI (centre cell) ── -->
      <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="44,*">
        <!-- Title bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="{DynamicResource BgSunkenBrush}">
          <Border
            Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
          />

          <!-- Draggable region (brand). Excludes the buttons so a button
                         press can never start a window drag. -->
          <Border Grid.Column="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
            <StackPanel
              Orientation="Horizontal"
              Spacing="10"
              VerticalAlignment="Center"
              Margin="14,0,0,0"
            >
              <Border
                Width="24"
                Height="24"
                CornerRadius="6"
                Background="{DynamicResource AccentBrush}"
              >
                <PathIcon
                  Data="{StaticResource IconBolt}"
                  Width="13"
                  Height="13"
                  Foreground="#1B1205"
                />
              </Border>
              <TextBlock
                Text="DOTA IHL"
                FontSize="13"
                FontWeight="Bold"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </Border>

          <!-- Window controls -->
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Classes="winbtn" Click="Minimize_Click" ToolTip.Tip="Minimize">
              <Path
                Data="M0,0 H10"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1"
              />
            </Button>
            <Button Classes="winbtn" Click="Maximize_Click" ToolTip.Tip="Maximize">
              <Path
                Data="M0,0 H10 V10 H0 Z"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1"
                Fill="Transparent"
              />
            </Button>
            <Button Classes="winbtn close" Click="Close_Click" ToolTip.Tip="Close">
              <Path
                Data="M0,0 L10,10 M10,0 L0,10"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.2"
              />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Body: auth-gated content (Login / Registration / Shell) -->
        <Panel Grid.Row="1">
          <ContentControl Content="{Binding CurrentView}" />

          <!-- Startup auto-login overlay -->
          <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource BgBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
              <ProgressBar
                IsIndeterminate="True"
                Width="200"
                Height="4"
                Foreground="{DynamicResource AccentBrush}"
                Background="{DynamicResource SurfaceHoverBrush}"
              />
              <TextBlock Text="Loading…" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Toast host (top-right) -->
          <ItemsControl
            ItemsSource="{Binding Toasts.Items}"
            Width="320"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,16,16,0"
          >
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:ToastItem">
                <Border
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  ClipToBounds="True"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Margin="0,0,0,10"
                >
                  <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{Binding Accent}" />
                    <TextBlock
                      Grid.Column="1"
                      Margin="14,12"
                      Text="{Binding Message}"
                      TextWrapping="Wrap"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                    />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </Grid>
    </Grid>
  </Border>
</Window>
