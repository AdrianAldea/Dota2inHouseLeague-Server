<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IHLDota2Bot.Desktop.ViewModels"
             xmlns:conv="using:IHLDota2Bot.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
             x:Class="IHLDota2Bot.Desktop.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.delta.win">
            <Setter Property="Foreground" Value="{DynamicResource WinBrush}"/>
        </Style>
        <Style Selector="TextBlock.delta.loss">
            <Setter Property="Foreground" Value="{DynamicResource LossBrush}"/>
        </Style>
        <Style Selector="Border.resultDot.win">
            <Setter Property="Background" Value="{DynamicResource WinBrush}"/>
        </Style>
        <Style Selector="Border.resultDot.loss">
            <Setter Property="Background" Value="{DynamicResource LossBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="36" Spacing="22" MaxWidth="1040">

            <!-- Identity header -->
            <Border Classes="card" Padding="28">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="76" Height="76" CornerRadius="999"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding Initial}" FontSize="34" FontWeight="Bold"
                                   Foreground="#1B1205" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{Binding Username}" Classes="h1"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="pill">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding Rating, Converter={x:Static conv:RatingToTierBrushConverter.Instance}}"/>
                                    <TextBlock Text="{Binding Rating, Converter={x:Static conv:RatingToTierNameConverter.Instance}}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Rating, Converter={x:Static conv:RatingToTierBrushConverter.Instance}}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="pill" IsVisible="{Binding HasRank}">
                                <TextBlock Text="{Binding Rank, StringFormat='Rank #{0}'}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentSolidBrush}"/>
                            </Border>
                            <Border Classes="pill" IsVisible="{Binding HasRank}">
                                <TextBlock Text="{Binding Percentile, StringFormat='Top {0:0.#}%'}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Classes="pill">
                                <TextBlock Text="{Binding TotalPlayers, StringFormat='{}{0} players'}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Rating}" Classes="stat" FontSize="40" HorizontalAlignment="Right"
                                   Foreground="{Binding Rating, Converter={x:Static conv:RatingToTierBrushConverter.Instance}}"/>
                        <TextBlock Text="RATING" Classes="caption" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stat tiles -->
            <UniformGrid Columns="4">
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="WINS" Classes="caption"/>
                        <TextBlock Text="{Binding Wins}" Classes="stat" Foreground="{DynamicResource WinBrush}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="LOSSES" Classes="caption"/>
                        <TextBlock Text="{Binding Losses}" Classes="stat" Foreground="{DynamicResource LossBrush}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="MATCHES" Classes="caption"/>
                        <TextBlock Text="{Binding MatchesPlayed}" Classes="stat"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="WIN RATE" Classes="caption"/>
                        <TextBlock Text="{Binding WinRate, StringFormat='{}{0:P0}'}" Classes="stat"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent matches -->
            <Border Classes="card" Padding="8,12">
                <StackPanel>
                    <TextBlock Text="RECENT MATCHES" Classes="caption" Margin="18,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding RecentMatches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="18,0" Height="52">
                                    <Border Grid.Column="0" Classes="resultDot" Width="10" Height="10"
                                            CornerRadius="999" VerticalAlignment="Center"
                                            Classes.win="{Binding IsWin}" Classes.loss="{Binding !IsWin}"/>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Result}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Mode}" Classes="muted"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,22,0"
                                               Classes="muted" Text="{Binding When}"/>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"
                                               Classes="delta" Classes.win="{Binding IsWin}" Classes.loss="{Binding !IsWin}"
                                               Text="{Binding RatingChange}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
